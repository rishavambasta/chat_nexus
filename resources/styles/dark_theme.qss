/* P2P Chat Modern Dark Theme (WhatsApp / Slate Dark Palette) */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #e9edef;
    outline: none;
}

QWidget {
    background-color: #111b21;
    color: #e9edef;
    font-size: 13px;
}

/* Splitter */
QSplitter::handle {
    background-color: #202c33;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #00a884;
}

/* Left Pane Header */
#leftHeader {
    background-color: #202c33;
    border-bottom: 1px solid #2a3942;
    padding: 8px;
}

#myAliasLabel {
    font-size: 15px;
    font-weight: bold;
    color: #e9edef;
}

#myInfoLabel {
    font-size: 12px;
    color: #00a884;
}

/* Search bar */
QLineEdit#searchPeerEdit {
    background-color: #202c33;
    border: 1px solid #2a3942;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e9edef;
    font-size: 13px;
}

QLineEdit#searchPeerEdit:focus {
    border: 1px solid #00a884;
}

/* Peer List */
QListWidget#peerList {
    background-color: #111b21;
    border: none;
    outline: none;
}

QListWidget#peerList::item {
    background-color: transparent;
    border-bottom: 1px solid #1f2c34;
    padding: 10px;
    border-radius: 0px;
}

QListWidget#peerList::item:hover {
    background-color: #202c33;
}

QListWidget#peerList::item:selected {
    background-color: #2a3942;
}

/* Right Pane Header */
#chatHeader {
    background-color: #202c33;
    border-bottom: 1px solid #2a3942;
    padding: 8px 16px;
}

#chatPeerAlias {
    font-size: 16px;
    font-weight: bold;
    color: #e9edef;
}

#chatPeerStatus {
    font-size: 12px;
    color: #8696a0;
}

/* Chat Messages Scroll Area */
#chatScrollArea {
    background-color: #0b141a;
    border: none;
}

#chatScrollContent {
    background-color: #0b141a;
}

/* Message Input Area */
#inputContainer {
    background-color: #202c33;
    border-top: 1px solid #2a3942;
    padding: 8px 12px;
}

QTextEdit#messageInput {
    background-color: #2a3942;
    border: 1px solid #3b4a54;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e9edef;
    font-size: 14px;
    max-height: 100px;
}

QTextEdit#messageInput:focus {
    border: 1px solid #00a884;
}

/* Buttons */
QPushButton {
    background-color: #202c33;
    border: 1px solid #2a3942;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e9edef;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2a3942;
    border-color: #3b4a54;
}

QPushButton:pressed {
    background-color: #182229;
}

/* Primary Accent Buttons */
QPushButton#primaryBtn, QPushButton#sendBtn, QPushButton#addPeerBtn {
    background-color: #00a884;
    color: #111b21;
    border: none;
    font-weight: bold;
    border-radius: 6px;
}

QPushButton#primaryBtn:hover, QPushButton#sendBtn:hover, QPushButton#addPeerBtn:hover {
    background-color: #02906f;
}

QPushButton#primaryBtn:pressed, QPushButton#sendBtn:pressed, QPushButton#addPeerBtn:pressed {
    background-color: #017a5e;
}

QPushButton#attachBtn {
    background-color: transparent;
    border: none;
    font-size: 18px;
    padding: 6px;
    border-radius: 20px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#attachBtn:hover {
    background-color: #2a3942;
}

/* Dialogs */
QDialog {
    background-color: #111b21;
    border: 1px solid #2a3942;
}

QLabel {
    color: #e9edef;
}

QLineEdit {
    background-color: #202c33;
    border: 1px solid #2a3942;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e9edef;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #00a884;
}

/* Progress Bar */
QProgressBar {
    background-color: #182229;
    border: 1px solid #2a3942;
    border-radius: 4px;
    text-align: center;
    color: #e9edef;
    font-size: 11px;
    font-weight: bold;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #00a884;
    border-radius: 3px;
}

/* ScrollBar Styling */
QScrollBar:vertical {
    background: #111b21;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #374045;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #4a545a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
